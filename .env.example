# Copy to .env and edit. .env is gitignored. Do not commit real keys.

# off (default): keep events on this machine.
# mock: send text events to scripts/mock_cloud.py.
# aws: send text events to the deployed API Gateway URL.
NUDGE_CLOUD=off

# mock: http://127.0.0.1:8787
# aws: the ApiUrl from `sam deploy`, with no path on the end.
NUDGE_API_URL=

# Ingest key sent as the x-api-key header.
# For the local mock only, local-dev-key matches the server's default.
# Generate a different long random key before any AWS deploy.
NUDGE_API_KEY=

# Optional. The dashboard token, if you set a separate one on AWS.
# Leave blank to reuse NUDGE_API_KEY for the local mock.
NUDGE_DASHBOARD_TOKEN=

# Name stored on each event so a caregiver can tell rooms apart.
NUDGE_DEVICE_NAME=kitchen

# How long to wait is a camera flag, not an environment variable:
#   python src/main.py --nudge-after 180 --nudge-repeat 60 --max-reminders 4
#   python src/main.py --no-escalate
# Use --nudge-after 15 for a short demo.
